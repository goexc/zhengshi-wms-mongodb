{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite --open",
    "typecheck": "vue-typecheck --noEmit && tsc --noEmit -p tsconfig.node.json",
    "build:test": "pnpm run typecheck && vite build --mode test",
    "build:prod": "pnpm run typecheck && vite build --mode production",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "fix": "eslint src --fix",
    "format": "prettier --write \"./**/*.{html,vue,ts,js,json,md}\"",
    "lint:eslint": "eslint src --cache",
    "lint:style": "stylelint \"src/**/*.{css,scss,vue}\" --cache",
    "preinstall": "node ./scripts/preinstall.js",
    "deps:check": "ncu",
    "deps:update": "ncu --upgrade",
    "lint:style:fix": "pnpm run lint:style --fix",
    "test": "node --test scripts/*.test.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@types/nprogress": "^0.2.3",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "element-plus": "^2.14.7",
    "exceljs": "^4.4.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "nprogress": "^0.2.0",
    "number-precision": "^1.6.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.44",
    "vue-clipboard3": "^2.0.0",
    "vue-router": "^5.4.0",
    "pinia-plugin-persistedstate": "^4.7.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@zhengshi/vue-typescript": "workspace:*",
    "@vitejs/plugin-vue": "6.0.10",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.11.1",
    "mockjs": "^1.1.0",
    "postcss": "^8.5.30",
    "postcss-html": "^2.0.0",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.10",
    "sass": "^1.105.2",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^2.0.0",
    "stylelint-order": "^8.1.2",
    "stylelint-scss": "^7.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-svg-icons": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "globals": "^17.13.0",
    "vue-eslint-parser": "^10.4.1",
    "@stylistic/stylelint-plugin": "^5.3.1",
    "npm-check-updates": "^23.1.1",
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
