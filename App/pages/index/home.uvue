	color: #ffffff;
	font-weight: 700;
	margin-top: 10px;
}
.welcome-department {
	font-size: 16px;
	line-height: 24px;
	color: #dcfce7;
	margin-top: 6px;
}
.section-heading {
	margin-bottom: 16px;
}
.entry-card {
	min-height: 140px;
	align-items: center;
	justify-content: center;
	background-color: #ffffff;
	border: 1px solid #9bb3a3;
	border-radius: 12px;
	padding: 20px 12px;
	margin-bottom: 12px;
}
.entry-icon {
	width: 52px;
	height: 52px;
	align-items: center;
	justify-content: center;
	background-color: #eaf5ee;
	border-radius: 12px;
	margin-bottom: 12px;
}
.entry-title {
	text-align: center;
}
.entry-pressed {
	background-color: #eaf5ee;
}
